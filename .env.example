# OnionDrop Configuration
# Run `python scripts/generate_credentials.py` to generate secure values.

# Argon2id password hash for upload authentication (REQUIRED)
# Example: UPLOAD_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
UPLOAD_PASSWORD_HASH=

# Cryptographically secure secret key for signing session tokens (REQUIRED, minimum 32 chars)
# Example: SESSION_SECRET='your-random-high-entropy-secret-key-here'
SESSION_SECRET=

# Maximum allowed file upload size in Megabytes (default: 100)
MAX_FILE_SIZE_MB=100

# Set COOKIE_SECURE=true only if hosting behind an HTTPS TLS termination proxy.
# Default is false because native Tor .onion connections are encrypted at the transport layer
# without standard TLS certificates, and browsers reject Secure cookies over plain http://*.onion.
COOKIE_SECURE=false

# SameSite cookie policy ('lax' or 'strict')
COOKIE_SAMESITE=lax

# Session validity duration in hours
SESSION_EXPIRE_HOURS=4
